# Copy to .env.local for local development, or .env for docker compose.

# Where the SQLite database file lives.
DATABASE_PATH=./data/larchbudget.db

# The currency of your budget (ISO 4217) and the locale for formatting.
CURRENCY=EUR
LOCALE=en-US

# Your time zone, which decides what "today" and "this month" are. Without
# it the server's own zone is used, which is UTC in Docker.
TZ=Europe/Amsterdam

# Leave empty to run without a login (own machine only).
# Set it to require this password on every page.
APP_PASSWORD=
